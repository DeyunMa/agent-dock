{
  "name": "@mdy/agent-dock",
  "version": "1.3.0",
  "private": true,
  "description": "A fail-open local Agent Dock for Codex Desktop and Codex CLI.",
  "type": "module",
  "bin": {
    "agent-dock": "bin/agent-dock.js",
    "codex": "bin/codex.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:macos": "swift build --package-path apps/macos/AgentDockBar",
    "bundle:macos": "./scripts/macos/build-app.sh",
    "run:macos": "swift run --package-path apps/macos/AgentDockBar AgentDockBar",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:training": "tsc -p tools/training/tsconfig.json",
    "test": "node --import tsx --test test/**/*.test.ts test/*/**/*.test.ts",
    "test:training": "node --import tsx --test tools/training/test/**/*.test.ts",
    "check": "pnpm typecheck && pnpm typecheck:training && pnpm test && pnpm test:training",
    "training:prepare": "tsx tools/training/src/prepare-dataset.ts",
    "training:prepare-review": "tsx tools/training/src/prepare-review-batches.ts",
    "training:merge-review": "tsx tools/training/src/merge-teacher-review.ts",
    "training:prepare-adjudication": "tsx tools/training/src/prepare-adjudication-batches.ts",
    "training:apply-adjudication": "tsx tools/training/src/apply-adjudication.ts",
    "training:prepare-synthetic": "tsx tools/training/src/prepare-synthetic-batches.ts",
    "training:prepare-synthetic-review": "tsx tools/training/src/prepare-synthetic-review.ts",
    "training:finalize-pretraining": "tsx tools/training/src/finalize-pretraining.ts",
    "training:test-python": "tools/training/work/venv/bin/python -m unittest discover -s tools/training/python -p 'test_*.py'",
    "training:train-baseline": "OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4 VECLIB_MAXIMUM_THREADS=4 NUMEXPR_NUM_THREADS=4 tools/training/work/venv/bin/python tools/training/python/train_baseline.py --run-id baseline-v3",
    "training:evaluate-hybrid": "tsx tools/training/src/evaluate-hybrid.ts",
    "training:scrub-derived": "tsx tools/training/src/scrub-derived-data.ts",
    "training:verify-model": "tsx tools/training/src/verify-model.ts",
    "control": "node dist/src/index.js control-server"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "smol-toml": "^1.4.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.0"
}
