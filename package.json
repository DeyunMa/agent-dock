{
  "name": "@mdy/codex-router",
  "version": "0.1.0",
  "private": true,
  "description": "A fail-open, local AI router for Codex Desktop and Codex CLI.",
  "type": "module",
  "bin": {
    "codex-router": "bin/codex-router.js",
    "codex": "bin/codex.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:macos": "swift build --package-path macos/CodexRouterBar",
    "bundle:macos": "./scripts/build-macos-app.sh",
    "run:macos": "swift run --package-path macos/CodexRouterBar CodexRouterBar",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:training": "tsc -p local-training/tsconfig.json",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:training": "node --import tsx --test local-training/test/**/*.test.ts",
    "check": "pnpm typecheck && pnpm typecheck:training && pnpm test && pnpm test:training",
    "training:prepare": "tsx local-training/src/prepare-dataset.ts",
    "training:prepare-review": "tsx local-training/src/prepare-review-batches.ts",
    "training:merge-review": "tsx local-training/src/merge-teacher-review.ts",
    "training:prepare-adjudication": "tsx local-training/src/prepare-adjudication-batches.ts",
    "training:apply-adjudication": "tsx local-training/src/apply-adjudication.ts",
    "training:prepare-synthetic": "tsx local-training/src/prepare-synthetic-batches.ts",
    "training:prepare-synthetic-review": "tsx local-training/src/prepare-synthetic-review.ts",
    "training:finalize-pretraining": "tsx local-training/src/finalize-pretraining.ts",
    "training:scrub-derived": "tsx local-training/src/scrub-derived-data.ts",
    "training:verify-model": "tsx local-training/src/verify-model.ts",
    "control": "node dist/src/index.js control-server"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "smol-toml": "^1.4.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.0"
}
