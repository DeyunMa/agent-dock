version = 3
enabled = true

[classifier]
enabled = true
base_url = "https://api.typesafe.ai"
model = "jev-latest"
api_key_file = "~/.agent-dock/credentials/jev-api-key"
timeout_ms = 2500
max_chars = 12000

[routing]
state_directory = "~/.agent-dock/thread-routes"
respect_cli_model_flag = true
route_order = ["quick", "balanced", "deep"]

[routing.controls]
step_up = ["加强一点", "再加强一点", "提高一档"]
max = ["最高强度", "拉满"]
auto = ["恢复自动", "自动路由"]
fallback_route = "deep"

[routes.quick]
model = "gpt-5.6-terra"
effort = "low"
fast = true

[routes.balanced]
model = "gpt-5.6-sol"
effort = "high"
fast = false

[routes.deep]
model = "gpt-6-astra"
effort = "xhigh"
fast = false

[gateway]
kind = "opencodex"
base_url = "http://127.0.0.1:10100"
managed = true

[codex]
cli_binary = "/opt/homebrew/bin/codex"
desktop_binary = "/Applications/ChatGPT.app/Contents/Resources/codex"

[logging]
audit_file = "~/.agent-dock/events.jsonl"
max_file_bytes = 31457280
max_backups = 1
