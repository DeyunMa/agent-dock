version = 1
enabled = true
rules_file = "~/.codex/router/router-rules.json"

[ollama]
enabled = true
base_url = "http://127.0.0.1:11434"
model = "qwen3.5:2b-q4_K_M"
timeout_ms = 3000
keep_alive = "30m"
context_length = 4096
max_prompt_chars = 3500
minimum_confidence = 0.58

[routing]
sticky_turns = true
respect_cli_model_flag = true
route_order = ["quick", "balanced", "deep", "max"]

[routing.controls]
step_up = ["加强一点", "再加强一点", "提高一档"]
max = ["最高强度", "拉满"]
auto = ["恢复自动", "自动路由"]
fallback_route = "deep"

[routing.category_routes]
RESEARCH_EXPLAIN = "quick"
AUDIT_ANALYZE = "balanced"
DIAGNOSE_FIX = "deep"
PLAN_DESIGN = "deep"
IMPLEMENT_CHANGE = "balanced"
OPERATE_VERIFY = "balanced"
CREATE_ARTIFACT = "deep"
AGENT_WORKFLOW = "deep"
PASS_CONTEXT = "inherit"

[routing.complexity_routes]
simple = "quick"
normal = "inherit"
complex = "deep"
extreme = "max"

[routes.quick]
model = "gpt-5.6-luna"
effort = "low"
fast = true

[routes.balanced]
model = "gpt-5.6-terra"
effort = "max"
fast = false

[routes.deep]
model = "gpt-5.6-sol"
effort = "high"
fast = false

[routes.max]
model = "gpt-5.6-sol"
effort = "xhigh"
fast = false

[gateway]
kind = "opencodex"
base_url = "http://127.0.0.1:10100"
managed = true

[codex]
cli_binary = "/opt/homebrew/bin/codex"
desktop_binary = "/Applications/ChatGPT.app/Contents/Resources/codex"

[logging]
audit_file = "~/.codex/router/events.jsonl"
max_file_bytes = 31457280
max_backups = 1
